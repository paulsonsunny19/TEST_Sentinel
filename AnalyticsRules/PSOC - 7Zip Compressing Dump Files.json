{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "source": "PSOC - 7Zip Compressing Dump Files.yaml",
    "generator": "convert_sentinel_yaml.py"
  },
  "parameters": {
    "workspace": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Sentinel Log Analytics workspace name"
      }
    }
  },
  "variables": {
    "ruleId": "0678c31e-3733-4d90-8d6a-176380bd936a"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/Microsoft.SecurityInsights/{1}', parameters('workspace'), variables('ruleId'))]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "PSOC - 7Zip Compressing Dump Files",
        "description": "Detects compression of memory dump files (.dmp, .dump, .hdmp) using 7-Zip binaries,\nwhich may indicate credential extraction activity.\n",
        "severity": "Medium",
        "enabled": true,
        "query": "// Schema-safe detection for 7zip compression of dump files\nSecurityEvent\n| where EventID == 4688\n| extend\n    Account = coalesce(\n        column_ifexists(\"SubjectUserName\", \"\"),\n        column_ifexists(\"Account\", \"\")\n    ),\n    AccountDomain = column_ifexists(\"SubjectDomainName\", \"\"),\n    Computer = column_ifexists(\"Computer\", \"\"),\n    NewProcessName = column_ifexists(\"NewProcessName\", \"\"),\n    NewProcessId = tostring(column_ifexists(\"NewProcessId\", \"\")),\n    ParentProcessName = column_ifexists(\"ParentProcessName\", \"\"),\n    CommandLine = column_ifexists(\"CommandLine\", \"\")\n| extend NewProcessNameLower = tolower(NewProcessName)\n| where NewProcessNameLower has_any (\"7z.exe\", \"7zr.exe\", \"7za.exe\")\n| where CommandLine has_any (\".dmp\", \".dump\", \".hdmp\")\n| where isnotempty(CommandLine)\n",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT30M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "tactics": [
          "CredentialAccess"
        ],
        "techniques": [
          "T1003"
        ],
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "Account"
              },
              {
                "identifier": "NTDomain",
                "columnName": "AccountDomain"
              }
            ]
          },
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "Computer"
              }
            ]
          },
          {
            "entityType": "Process",
            "fieldMappings": [
              {
                "identifier": "ProcessId",
                "columnName": "NewProcessId"
              },
              {
                "identifier": "CommandLine",
                "columnName": "CommandLine"
              }
            ]
          }
        ],
        "suppressionEnabled": false,
        "suppressionDuration": "PT5H",
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        }
      }
    }
  ],
  "outputs": {
    "analyticsRuleId": {
      "type": "string",
      "value": "[variables('ruleId')]"
    }
  }
}
