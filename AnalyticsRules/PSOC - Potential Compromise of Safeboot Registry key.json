{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "source": "PSOC - Potential Compromise of Safeboot Registry key.yaml",
    "generator": "convert_sentinel_yaml.py"
  },
  "parameters": {
    "workspace": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Sentinel Log Analytics workspace name"
      }
    }
  },
  "variables": {
    "ruleId": "cb9af3df-7dca-4bb5-abd9-f4c387608187"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/Microsoft.SecurityInsights/{1}', parameters('workspace'), variables('ruleId'))]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "PSOC - Potential Compromise of Safeboot Registry key",
        "description": "detects changes to the safeboot registry key as seen in the DFIR report",
        "severity": "Medium",
        "enabled": true,
        "query": "//Detects attempted compromise of the safeboot registry key\nlet cmd_all = dynamic([\"reg\",\"\\\\Control\\\\SafeBoot\"]);\nlet cmd_any = dynamic([\"add\",\"copy\",\"delete\"]);\n_Im_ProcessCreate(commandline_has_all=cmd_all,commandline_has_any=cmd_any)\n| extend\n    Account = tostring(column_ifexists(\"ActorUsername\", \"\")),\n    AccountDomain = tostring(column_ifexists(\"ActorUserDomain\", \"\")),\n    Computer = tostring(column_ifexists(\"DvcHostname\", \"\")),\n    ProcessName = tostring(column_ifexists(\"TargetProcessName\", \"\")),\n    ProcessId = tostring(column_ifexists(\"TargetProcessId\", \"\")),\n    CommandLine = tostring(column_ifexists(\"CommandLine\", \"\"))\n| where isnotempty(ProcessName)  ",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT30M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "tactics": [
          "DefenseEvasion",
          "Persistence"
        ],
        "techniques": [
          "T1112",
          "T1547"
        ],
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "Account"
              },
              {
                "identifier": "NTDomain",
                "columnName": "AccountDomain"
              }
            ]
          },
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "Computer"
              }
            ]
          },
          {
            "entityType": "Process",
            "fieldMappings": [
              {
                "identifier": "ProcessId",
                "columnName": "ProcessId"
              },
              {
                "identifier": "CommandLine",
                "columnName": "CommandLine"
              }
            ]
          }
        ],
        "suppressionEnabled": false,
        "suppressionDuration": "PT5H",
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        }
      }
    }
  ],
  "outputs": {
    "analyticsRuleId": {
      "type": "string",
      "value": "[variables('ruleId')]"
    }
  }
}
