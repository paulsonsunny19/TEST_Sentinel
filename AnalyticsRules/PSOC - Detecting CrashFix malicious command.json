{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "source": "PSOC - Detecting CrashFix malicious command.yaml",
    "generator": "convert_sentinel_yaml.py"
  },
  "parameters": {
    "workspace": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Sentinel Log Analytics workspace name"
      }
    }
  },
  "variables": {
    "ruleId": "0fe20175-4735-4f75-950f-2d9204732eaf"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/Microsoft.SecurityInsights/{1}', parameters('workspace'), variables('ruleId'))]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "PSOC - Detecting CrashFix malicious command",
        "description": "The command can fetch data from remote servers and pipe the output directly to the command line. In this case, the malicious command copies finger.exe from System32 to the %temp% directory (renaming it to ct.exe to avoid detection), then uses it to connect to a remote IP and pipes the response directly to cmd, executing whatever payload the attacker's server returns.",
        "severity": "Medium",
        "enabled": true,
        "query": "//Detecting CrashFix malicious command\nSecurityEvent\n| where Process has_any (\"cmd.exe\", \"powershell.exe\")\n| where CommandLine has_all (\"start\",\"min\",\"copy\")\n| where CommandLine has_all (\"ct.exe\",\"finger.exe\")\n| extend\n    ComputerName = tostring(column_ifexists(\"Computer\", \"\")),\n    Account = tostring(\n        coalesce(\n            column_ifexists(\"SubjectUserName\", \"\"),\n            column_ifexists(\"Account\", \"\")\n        )\n    ),\n    ProcessId = tostring(column_ifexists(\"NewProcessId\", \"\")),\n    CommandLineMapped = tostring(column_ifexists(\"CommandLine\", \"\"))",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT30M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "tactics": [
          "DefenseEvasion"
        ],
        "techniques": [
          "T1036.003"
        ],
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "ComputerName"
              }
            ]
          },
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "Account"
              }
            ]
          },
          {
            "entityType": "Process",
            "fieldMappings": [
              {
                "identifier": "ProcessId",
                "columnName": "ProcessId"
              },
              {
                "identifier": "CommandLine",
                "columnName": "CommandLineMapped"
              }
            ]
          }
        ],
        "suppressionEnabled": false,
        "suppressionDuration": "PT5H",
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        }
      }
    }
  ],
  "outputs": {
    "analyticsRuleId": {
      "type": "string",
      "value": "[variables('ruleId')]"
    }
  }
}
