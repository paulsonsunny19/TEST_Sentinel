{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "source": "PSOC - New Enumeration tool was installed.yaml",
    "generator": "convert_sentinel_yaml.py"
  },
  "parameters": {
    "workspace": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Sentinel Log Analytics workspace name"
      }
    }
  },
  "variables": {
    "ruleId": "8e383cfe-2d9e-4dea-9286-e8267ac3f99d"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/Microsoft.SecurityInsights/{1}', parameters('workspace'), variables('ruleId'))]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "PSOC - New Enumeration tool was installed",
        "description": "Detects common enumeration tools being installed.",
        "severity": "Medium",
        "enabled": true,
        "query": "DeviceEvents\n| where ActionType == \"ServiceInstalled\"\n| where tostring(AdditionalFields.ServiceName) matches regex @\"(?i)(nmap|nuclei|massscan|angryIP|zmap|shodan|ipscan)\"\n| extend\n  Computer = tostring(column_ifexists(\"DeviceName\", \"\")),\n  Account = tostring(column_ifexists(\"AccountName\", \"\")),\n  ProcessId = tostring(column_ifexists(\"InitiatingProcessId\", \"\")),\n  CommandLineMapped = tostring(column_ifexists(\"InitiatingProcessCommandLine\", \"\"))",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT30M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "tactics": [
          "Discovery"
        ],
        "techniques": [
          "T1046"
        ],
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "Computer"
              }
            ]
          },
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "Account"
              }
            ]
          },
          {
            "entityType": "Process",
            "fieldMappings": [
              {
                "identifier": "ProcessId",
                "columnName": "ProcessId"
              },
              {
                "identifier": "CommandLine",
                "columnName": "CommandLineMapped"
              }
            ]
          }
        ],
        "suppressionEnabled": false,
        "suppressionDuration": "PT5H",
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        }
      }
    }
  ],
  "outputs": {
    "analyticsRuleId": {
      "type": "string",
      "value": "[variables('ruleId')]"
    }
  }
}
